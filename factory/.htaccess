Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^src(?:/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

<FilesMatch "^(?!index\.php$).+\.php$">
    Require all denied
</FilesMatch>
